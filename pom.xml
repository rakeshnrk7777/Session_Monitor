<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.igniterealtime.openfire</groupId>
        <artifactId>plugins</artifactId>
        <version>5.0.0</version>
    </parent>

    <groupId>com.comitfs.openfire</groupId>
    <artifactId>session-monitor</artifactId>
    <version>1.0.0</version>

    <packaging>jar</packaging>

    <name>Openfire Session Monitor</name>
    <description>
        Openfire 5.0.0 client session monitor and lifecycle logger.
    </description>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!--
            The Openfire parent POM (org.igniterealtime.openfire:plugins) derives the
            precompiled-JSP servlet package from this property
            (org.jivesoftware.openfire.plugin.${plugin.name}), so it must be a valid
            Java identifier. The Maven artifactId ('session-monitor') is used for the
            plugin file name and may therefore contain dashes.
        -->
        <plugin.name>sessionmonitor</plugin.name>
    </properties>

    <build>
        <!--
            Compile directly into a root 'classes' folder, matching the layout that the
            Openfire parent POM's shared 'openfire-plugin-assembly' descriptor expects
            (pluginDir/plugin.xml, pluginDir/classes/, pluginDir/lib/, pluginDir/web/).
        -->
        <outputDirectory>classes</outputDirectory>

        <plugins>
            <!--
                The Openfire parent POM defines this 'make-assembly' execution using the
                official openfire-plugin-assembly descriptor. We only override the final
                name so the generated plugin archive matches our artifact name.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <executions>
                    <execution>
                        <id>make-assembly</id>
                        <configuration>
                            <finalName>${project.artifactId}</finalName>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Compile Openfire admin-console JSP files -->
            <plugin>
                <groupId>org.eclipse.jetty.ee8</groupId>
                <artifactId>jetty-ee8-jspc-maven-plugin</artifactId>
            </plugin>

            <!-- 'mvn clean' also removes the root classes/ build output -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <version>3.2.0</version>
                <artifactId>maven-clean-plugin</artifactId>
                <configuration>
                    <filesets>
                        <fileset>
                            <directory>classes</directory>
                        </fileset>
                    </filesets>
                </configuration>
            </plugin>

            <!--
                Recreate the tracked classes/.gitkeep placeholder right after 'mvn
                clean' has removed the classes/ build output, so the folder remains
                part of the project structure.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>ensure-classes-folder</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <mkdir dir="classes"/>
                                <touch file="classes/.gitkeep"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!--
            <plugin>
                <groupId>org.owasp</groupId>
                <artifactId>dependency-check-maven</artifactId>
                <version>13.0.0</version>
                <configuration>
                    <failBuildOnCVSS>8.0</failBuildOnCVSS>

                    <formats>
                        <format>HTML</format>
                        <format>JSON</format>
                    </formats>


                    <nvdApiServerId>nvd-api</nvdApiServerId>
                </configuration>
                <executions>
                    <execution>
                        <id>owasp-dependency-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            -->
        </plugins>
    </build>

    <repositories>
        <repository>
            <id>igniterealtime</id>
            <name>Ignite Realtime Repository</name>
            <url>
                https://igniterealtime.org/archiva/repository/maven/
            </url>
        </repository>
    </repositories>

    <pluginRepositories>
        <pluginRepository>
            <id>igniterealtime</id>
            <name>Ignite Realtime Repository</name>
            <url>
                https://igniterealtime.org/archiva/repository/maven/
            </url>
        </pluginRepository>
    </pluginRepositories>

</project>